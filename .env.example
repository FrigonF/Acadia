# ACADIA Environment Configuration (.env)

PROJECT_NAME="ACADIA - Academic Identity Authenticated"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"
ENV="development"

# Secret Key for JWT Authentication
SECRET_KEY="acadia_dev_super_secret_jwt_key_sih26263_zenith_5_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for zero-friction local run; switch to PostgreSQL in production)
DATABASE_URL="sqlite:///./acadia_dev.db"
# DATABASE_URL="postgresql://acadia:acadia_secret@localhost:5432/acadia_db"

# Server-side keyed secret for privacy-preserving HMAC-SHA256 duplicate detection
HMAC_SECRET_KEY="acadia_identifier_hmac_secret_key_salt_sih26263"

# Ed25519 Cryptographic Signing Key (Hex seed)
ED25519_PRIVATE_KEY_HEX="4a5c6d7e8f901234567890abcdef1234567890abcdef1234567890abcdef1234"
KEY_ID="acadia-dev-key-2026-v1"

# External APAAR Adapter Config (Mock mode for standalone hackathon operation)
APAAR_MOCK_MODE=True
APAAR_API_BASE_URL="https://mock.apaar.gov.in/api/v1"
APAAR_CLIENT_ID="mock_acadia_client"
APAAR_CLIENT_SECRET="mock_secret"

# Public Base URL for verification QR links
PUBLIC_BASE_URL="http://localhost:8000"
