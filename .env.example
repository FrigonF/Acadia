# ACADIA Environment Configuration (.env.example)
# IMPORTANT: Copy this file to .env and replace all placeholders with strong random secrets.
# Never commit real keys or production secrets to source control.

PROJECT_NAME="ACADIA - Academic Identity Authenticated"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"
ENV="development" # Set to "production" in production environments

# Secret Key for JWT Authentication (Must be at least 32 characters in production)
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
DATABASE_URL="sqlite:///./acadia_dev.db"
# DATABASE_URL="postgresql://acadia:acadia_secret@localhost:5432/acadia_db"

# Server-side keyed secret for privacy-preserving HMAC-SHA256 duplicate detection (64-char hex)
HMAC_SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_HEX_64_CHARS"

# AES-256 Data-at-Rest Encryption Key for PII / APAAR identifiers (64-char hex for 256-bit key)
FIELD_ENCRYPTION_KEY="REPLACE_WITH_STRONG_RANDOM_HEX_64_CHARS"

# Ed25519 Cryptographic Signing Key (64-char private seed hex)
# Note: Treat any previous test/seed keys as compromised and rotate in production.
ED25519_PRIVATE_KEY_HEX="REPLACE_WITH_ED25519_PRIVATE_SEED_HEX_64_CHARS"
KEY_ID="acadia-platform-v1"

# JSON dictionary of trusted verification public keys (PEM string per key_id)
# e.g.: TRUSTED_PUBLIC_KEYS='{"acadia-platform-v1": "-----BEGIN PUBLIC KEY-----\n..."}'
TRUSTED_PUBLIC_KEYS="{}"

# External APAAR Adapter Config (Mock mode for testing/demo)
APAAR_MOCK_MODE=True
APAAR_API_BASE_URL="https://mock.apaar.gov.in/api/v1"
APAAR_CLIENT_ID="mock_acadia_client"
APAAR_CLIENT_SECRET="mock_secret"

# Public Base URL for verification QR links
PUBLIC_BASE_URL="http://localhost:8000"
